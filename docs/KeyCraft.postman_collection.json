  "item": [
    {
      "name": "01. Вход и текущий пользователь",
      "description": "Запросы выполняйте по одному. Примеры ID относятся к свежему локальному каталогу.",
      "item": [
        {
          "name": "POST Регистрация покупателя",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "description": "Лимит регистрации и входа: общие 10 запросов в минуту на IP. Поле role запрещено. Пароль подтверждается password_confirmation: минимум 8 символов, максимум 72 байта UTF-8, без NUL. Смена роли при регистрации запрещена.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Покупатель\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set(\"token\", body.token);",
                  "  if (body.data && body.data.id) pm.collectionVariables.set(\"user_id\", String(body.data.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Вход по email и паролю",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Неверный email или пароль возвращает общее сообщение без раскрытия существования email. 10 запросов в минуту на IP. Пароль не длиннее 72 байт UTF-8, без NUL; неверный формат даёт 422.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set(\"token\", body.token);",
                  "  if (body.data && body.data.id) pm.collectionVariables.set(\"user_id\", String(body.data.id));",
                  "}"
                ]
              }
            }
          ]
        },
